# 백엔드 API 주소 (끝에 /api 포함)
VITE_API_BASE_URL=http://localhost:8080/api

# 업로드 이미지(/uploads/..., /covers/...)를 불러올 서버 주소.
# 비워 두면 VITE_API_BASE_URL에서 끝의 /api를 뗀 값을 써요.
# VITE_SERVER_ORIGIN=http://localhost:8080

# 소셜 로그인 (둘 다 비워 두면 해당 버튼을 눌렀을 때 "설정되지 않았어요"라고 안내해요)
# 백엔드 application-secret.yaml의 google.client-id / microsoft.client-id와 같은 값이어야 해요.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# VITE_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# 앱 등록이 "이 조직 디렉터리의 계정만"이면 테넌트 ID도 넣어요(비우면 common).
# VITE_MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
